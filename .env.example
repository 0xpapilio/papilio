# Copy to .env.local for local dev; set the same two in Netlify > Site configuration > Environment variables.
# API key from resend.com/api-keys (needs full access, so it can create contacts as well as send).
RESEND_API_KEY=
# Sender. Must be on a domain you verified in Resend, e.g. Papilio <hello@yourdomain.xyz>.
# Left empty it uses onboarding@resend.dev, which only delivers to your own Resend account email.
RESEND_FROM=
