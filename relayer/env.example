# Copy to .env (cp env.example .env) and fill in. NEVER commit .env. Testnet keys only.

# --- Sepolia (relayer inventory) ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=0x...            # relayer key, funded with Sepolia ETH + WETH

# --- Aleo testnet ---
ALEO_ENDPOINT=https://api.explorer.provable.com/v1
ALEO_NETWORK=testnet
ALEO_PROGRAM=papilio_intent.aleo
RELAYER_ALEO_PRIVATE_KEY=APrivateKey1...   # relayer's Aleo key (faucet credits)
RELAYER_ALEO_VIEW_KEY=AViewKey1...         # decrypts IntentNote records
RELAYER_ALEO_ADDRESS=aleo1...

# --- demo user (separate account from the relayer) ---
USER_ALEO_PRIVATE_KEY=APrivateKey1...
USER_ALEO_VIEW_KEY=AViewKey1...
USER_ALEO_ADDRESS=aleo1...
DEMO_RECEIVER=0x...                  # Sepolia address that receives the trade output
